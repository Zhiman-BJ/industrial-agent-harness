{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "packages": {
    "apps/desktop": {
      "component": "desktop",
      "changelog-path": "CHANGELOG.md",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "beta",
      "pull-request-title-pattern": "chore(release): prepare desktop ${version}",
      "pull-request-header": "合并本 PR = 打 desktop-v${version} 标签并触发安装包发布流水线（release-desktop.yml）。发版说明可在本 PR 的 CHANGELOG 段落里直接润色。"
    }
  }
}
