    "@industrial-agent-harness/domain-skills": "workspace:*",
    "@industrial-agent-harness/harness-application": "workspace:*",
    "@industrial-agent-harness/harness-auth": "workspace:*",
    "@industrial-agent-harness/harness-core": "workspace:*",
    "@industrial-agent-harness/pack-manager": "workspace:*",
    "@industrial-agent-harness/viewer-builtin": "workspace:*",
    "@industrial-agent-harness/viewer-core": "workspace:*",
    "@zhiman-bj/industrial-domain-packs": "https://codeload.github.com/Zhiman-BJ/industrial-domain-packs/tar.gz/1117d840e35e521a0db5caf7161935ebc4930535",
    "electron-updater": "6.8.9",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
