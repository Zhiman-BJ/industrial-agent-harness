    "test": "node --test electron/*.test.cjs",
    "test:parallel": "node scripts/launch-electron.cjs --parallel-selftest",
    "test:images": "node scripts/launch-electron.cjs --image-input-selftest",
    "test:logs": "node scripts/launch-electron.cjs --agent-log-selftest",
    "test:kicad": "node scripts/launch-electron.cjs --kicad-selftest",
    "test:godot": "node scripts/launch-electron.cjs --godot-selftest",
    "test:documents": "node scripts/launch-electron.cjs --documents-selftest",
    "test:browser": "node scripts/launch-electron.cjs --browser-selftest",
    "test:language": "node scripts/launch-electron.cjs --language-selftest",
    "test:ui": "node scripts/launch-electron.cjs --ui-selftest",
    "test:project-onboarding": "node scripts/launch-electron.cjs --project-onboarding-selftest",
    "test:messages": "node scripts/launch-electron.cjs --messages-selftest",
    "test:engineering": "node scripts/launch-electron.cjs --engineering-selftest",
    "test:cad": "node scripts/launch-electron.cjs --cad-selftest",
    "setup:layout": "node scripts/setup-layout.cjs",
    "setup:kimi": "node scripts/setup-kimi.cjs",
    "test:chats": "node scripts/test-chats.cjs",
    "test:mcp": "node scripts/launch-electron.cjs --mcp-selftest && node scripts/launch-electron.cjs --remote-connection-selftest",
    "test:remote-connection": "node scripts/launch-electron.cjs --remote-connection-selftest",
    "test:external-mcp": "node scripts/launch-electron.cjs --external-mcp-selftest",
    "test:cad-resize": "node scripts/launch-electron.cjs --cad-resize-selftest",
    "test:subagents": "node scripts/launch-electron.cjs --subagent-selftest",
    "test:gui-settings": "node scripts/launch-electron.cjs --gui-settings-selftest",
    "test:model-sync": "node scripts/launch-electron.cjs --model-sync-selftest",
    "test:results": "node scripts/launch-electron.cjs --task-results-selftest",
    "test:account": "node scripts/launch-electron.cjs --account-selftest",
