{
  "name": "industrial-agent-harness",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Cross-platform industrial agent harness monorepo scaffold",
  "scripts": {
    "dev": "pnpm --filter @industrial-agent-harness/desktop dev",
    "build": "pnpm --filter @industrial-agent-harness/desktop build",
    "start": "pnpm --filter @industrial-agent-harness/desktop start",
    "cli": "node apps/cli/src/main.cjs",
    "package:headless": "node scripts/package-headless.cjs",
    "package:domains": "node scripts/build-pack-distribution.cjs",
    "stage:desktop": "node scripts/stage-desktop.cjs",
    "test:architecture": "node scripts/check-architecture-contract.cjs && node --test tests/architecture/*.test.cjs",
    "test:industrial-core": "node --test tests/integration/industrial-core*.test.cjs",
    "test:ci": "node scripts/ci-tests.cjs",
    "smoke:ci-packages": "node scripts/ci-package-smoke.cjs",
    "test": "pnpm --filter @industrial-agent-harness/contracts test && pnpm --filter @industrial-agent-harness/domain-runtime test && pnpm --filter @industrial-agent-harness/domain-skills test && pnpm --filter @industrial-agent-harness/domain-mcp test && pnpm --filter @industrial-agent-harness/pack-manager test && pnpm --filter @industrial-agent-harness/capability-broker test && pnpm --filter @industrial-agent-harness/computer-use-bridge test && pnpm --filter @industrial-agent-harness/harness-core test && pnpm --filter @industrial-agent-harness/agent-kimi test && pnpm --filter @industrial-agent-harness/harness-application test && pnpm --filter @industrial-agent-harness/cli test && pnpm --filter @industrial-agent-harness/viewer-core test && pnpm --filter @industrial-agent-harness/viewer-builtin test && pnpm --filter @industrial-agent-harness/desktop test && pnpm --filter @industrial-agent-harness/sdk test",
    "test:chat-resume": "node --test tests/integration/chat-resume.test.cjs",
    "test:compaction-compat": "node --test tests/integration/compaction-compat-kimi.test.cjs",
    "test:mcp": "node --test tests/integration/domain-mcp*.test.cjs tests/integration/pcb-mcp*.test.cjs tests/integration/chip-runtime-reliability.test.cjs",
    "test:external-mcp": "node --test tests/integration/external-mcp*.test.cjs",
    "test:pcb-mcp": "node --test tests/integration/pcb-mcp*.test.cjs",
    "format": "prettier --write \"{apps,packages,scripts,tests}/**/*.{cjs,mjs,js,ts,tsx,css}\"",
    "format:check": "prettier --check \"{apps,packages,scripts,tests}/**/*.{cjs,mjs,js,ts,tsx,css}\"",
    "benchmark:maintenance": "node scripts/benchmark-maintenance.cjs",
    "test:session-resources": "node --test tests/integration/session-resources-kimi.test.cjs",
    "stress:sessions": "node scripts/stress-sessions.cjs",
    "test:session-chaos": "node --test tests/integration/session-chaos-kimi.test.cjs",
    "test:release": "node scripts/check-pack-release.cjs",
    "test:benchmark": "node --test tests/benchmark/*.test.cjs",
    "benchmark:paired": "node scripts/benchmark-paired.cjs",
    "test:architecture-contract": "node scripts/check-architecture-contract.cjs && node --test tests/architecture/contract-policy.test.cjs tests/architecture/candidate-fetch.test.cjs",
    "test:results": "node --test tests/integration/task-results-freecad.test.cjs tests/integration/task-results-kimi.test.cjs"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  },
  "dependencies": {
    "@zhiman-bj/industrial-domain-packs": "https://codeload.github.com/Zhiman-BJ/industrial-domain-packs/tar.gz/4f737ef9f949a3b8c00e9bf00d2df748dff41320"
  }
}
